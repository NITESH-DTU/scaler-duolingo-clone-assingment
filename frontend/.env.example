# Set this in the Vercel project to the public FastAPI origin, without a path.
# Next.js proxies /svc/api/* to this host, keeping browser requests same-origin.
# BACKEND_PROXY_URL=https://your-api.onrender.com

# Optional direct API URL (bypasses the same-origin Next.js proxy).
# NEXT_PUBLIC_API_URL=https://your-api.example.com/api/v1
